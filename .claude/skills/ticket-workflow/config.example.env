# /ticket-workflow settings: the questions configure.sh asks, and their defaults. Each commented
# `# TW_NAME=default   # help` line is one question, in order; a `# ---` line starts a section.
# A checkout on a different board can override any of these in its own .tuntun/ticket-workflow.env.

# --- Jira: which tickets are mine to fix -------------------------------------------------------
# TW_BOARD_JQL='filter = 11001'          # bare JQL, no ORDER BY. Pickup board: assignee = me AND status in (Open, Reopened, Issues, Backlog)
# TW_FIXING_JQL='filter = 10550'         # in flight: assignee = me AND status = fixing
# TW_COMPONENT='ios'                     # the Jira component this pipeline fixes
# TW_EXCLUDE_COMPONENTS='BE'             # skip tickets carrying any of these (comma-separated; - for none)
# TW_JIRA_USER='tommy.yohanes'           # the account the pipeline comments as
# TW_NOT_QA="admin $TW_JIRA_USER"        # comment authors that are never the QA/design brief
# TW_HOSTS='A B'                         # every Mac's TT_HOST_ID running this pipeline

# --- GitLab ------------------------------------------------------------------------------------
# TW_GITLAB_HOST='git.tuntun.co.id'       # glab --hostname
# TW_GITLAB_PROJECT='49'                 # the app repo's GitLab project id
# TW_MR_ASSIGNEE="$TW_JIRA_USER"         # GitLab username the MR is assigned to

# --- Branches ----------------------------------------------------------------------------------
# TW_MAIN_BRANCH='main'                  # an RC already merged here counts as released
# TW_RC_PREFIX='release_candidate'       # RC branches are <prefix>/X.Y.Z
# TW_RC_FLOOR='2.4.0'                    # no version on the ticket → oldest live RC at or above this
# TW_BRANCH_PREFIX='tommy'               # fix branches are <prefix>/<RC>/<KEY>-<slug>

# --- Build and drive ---------------------------------------------------------------------------
# TW_WORKSPACE='TTSecuritas.xcworkspace' # xcodebuild -workspace
# TW_SCHEME='TTSecuritas Staging'        # the default smoke scheme
# TW_PRODUCTS='Staging-iphonesimulator'  # that scheme's DerivedData Build/Products folder
# TW_APP_NAME='Tuntun Sekuritas.app'     # the built .app's file name
# TW_SIM_DEVICE='iPhone 17'              # simulator to build for and drive
