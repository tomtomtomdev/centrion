<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Locks the screen straight after an automatic login (SPEC.md §8), so the listener can start
  after pmset's power-on without the desktop being left open.

  A one-shot: RunAtLoad and no KeepAlive. It runs once per login, which is when launchd loads
  ~/Library/LaunchAgents. install.sh copies this file but deliberately does not bootstrap it,
  because a bootstrap fires RunAtLoad immediately and would lock the screen of whoever is
  running install.sh. lockscreen.sh does nothing unless automatic login is set for this user.

  Same path rules as the bot's plist: absolute, __CHECKOUT__ written in by install.sh, nothing
  under ~/Documents, ~/Desktop or ~/Downloads.

  logs:  cat var/lockscreen.log
  test:  sh launchd/lockscreen.sh   (locks the screen if automatic login is on)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tommy.centrion.lock</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__CHECKOUT__/launchd/lockscreen.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CHECKOUT__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Interactive: the whole point is to beat a person to the keyboard. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__CHECKOUT__/var/lockscreen.log</string>
  <key>StandardErrorPath</key>
  <string>__CHECKOUT__/var/lockscreen.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
